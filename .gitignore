.DS_Store
.build/
.swiftpm/
*.xcodeproj
DerivedData/

# Private classifier fixture grown from real WeChat messages — never commit.
# The committed Tests/Fixtures/labeled_messages.json stays small + synthetic;
# real-data growth lives in this gitignored sibling.
Tests/Fixtures/labeled_messages_private.json
# classify-real default output goes to /tmp; ignore any local redirects too.
classify_real_*.json

# Local AI-agent working dirs (session logs, machine paths, harness state).
# Never publish: they leak host paths and are not part of the product.
.agent-harness/
.agent-checkpoints/
.superpowers/
.claude/

# Pixel-QA evidence is the app rendering the operator's *real* WeChat
# conversations — contact names and message bodies, at 2x, in PNG. 197 MB /
# 683 shots as of 2026-09-18. Keep them on disk for diffing rounds; never
# commit them to this public repo. Already-tracked shots under
# docs/qa/2026-09-08/design/ are unaffected (tracked files ignore .gitignore),
# and `git add -f` stays the escape hatch for a shot verified to be synthetic.
docs/qa/**/*-pixel/
docs/qa/**/*.png
docs/qa/**/*.jpg
